# ============================================================
# TMOpen - Variáveis de Produção (Hostinger VPS)
# ============================================================
# Copie este arquivo para a raiz do deploy no servidor
# e ajuste os valores. NÃO comite senhas reais no git.
# ============================================================

# ---------------------------
# PostgreSQL (NÃO use defaults em produção)
# ---------------------------
POSTGRES_USER=tmopen
POSTGRES_PASSWORD=  # gere uma senha forte, ex: openssl rand -base64 32
POSTGRES_DB=tmopen

# ---------------------------
# API
# ---------------------------
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# URL interna do Docker Compose (não precisa alterar)
DATABASE_URL=postgresql://tmopen:SUA_SENHA_AQUI@postgres:5432/tmopen?schema=public

# Segredo para assinatura de tokens (se usar autenticação futura)
JWT_SECRET=  # openssl rand -base64 48

# Origens permitidas no CORS. Produção: sua URL do frontend.
# Para liberar tudo (apenas dev):  CORS_ORIGIN=*
CORS_ORIGIN=https://tmopen.com.br

# ---------------------------
# Logs
# ---------------------------
LOG_LEVEL=info
