# ============================================================
# TMOpen - Variáveis de Produção (Hostinger VPS)
# ============================================================
# Copie este arquivo para .env na raiz do deploy no servidor
# e ajuste os valores. NÃO comite senhas reais no git.
# ============================================================

# ---------------------------
# PostgreSQL (NÃO use defaults em produção)
# ---------------------------
POSTGRES_USER=tmopen
POSTGRES_PASSWORD=  # gere uma senha forte, ex: openssl rand -base64 32
POSTGRES_DB=tmopen

# ---------------------------
# API
# ---------------------------
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# URL interna do Docker Compose (não precisa alterar)
DATABASE_URL=postgresql://tmopen:SUA_SENHA_AQUI@postgres:5432/tmopen?schema=public

# Segredo para assinatura de tokens (se usar autenticação futura)
JWT_SECRET=  # openssl rand -base64 48

# ---------------------------
# Autenticação API Key (OBRIGATÓRIO)
# ---------------------------
# Uma ou mais chaves separadas por vírgula.
# Cada cliente (ex: TMOrganizer) usa uma chave própria.
# Gerar: openssl rand -hex 32
TMOPEN_API_KEYS=coloque_sua_chave_aqui,outra_chave_se_tiver

# ---------------------------
# CORS
# ---------------------------
# Origens permitidas separadas por vírgula.
# Exemplo: CORS_ORIGINS=https://tm2b.com.br,https://app.tm2b.com.br,http://localhost:5000
# Para dev apenas (qualquer origem): CORS_ORIGINS=*
CORS_ORIGINS=https://tm2b.com.br

# ---------------------------
# Módulo Prospecção
# ---------------------------
# Limite de requisições por minuto por IP (rate limit global)
PROSPECT_RATE_LIMIT_MAX=60
# Tamanho máximo de página nos endpoints /prospect/* (>= 500)
PROSPECT_MAX_PAGE_SIZE=500

# ---------------------------
# Logs
# ---------------------------
LOG_LEVEL=info
