{
  "name": "tmopen",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "ts-node --project tsconfig.seed.json prisma/seed.ts",
    "import": "tsx src/modules/cnpj/importer/cli.ts",
    "import:dev": "tsx watch --clear-screen=false src/modules/cnpj/importer/cli.ts",
    "import:dry": "tsx src/modules/cnpj/importer/cli.ts --dry-run"
  },
  "bin": {
    "tmopen-import-cnpj": "dist/modules/cnpj/importer/cli.js"
  },
  "prisma": {
    "seed": "ts-node --project tsconfig.seed.json prisma/seed.ts"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^20.14.0",
    "@types/unzipper": "^0.10.11",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/sensible": "^5.6.0",
    "@fastify/swagger": "^8.15.0",
    "@prisma/client": "^5.22.0",
    "@scalar/fastify-api-reference": "^1.65.1",
    "cli-progress": "^3.12.0",
    "commander": "^15.0.0",
    "csv-parse": "^7.0.2",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.0",
    "fastify-type-provider-zod": "^2.1.0",
    "iconv-lite": "^0.7.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "unzipper": "^0.12.5",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  }
}
