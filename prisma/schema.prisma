generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model empresas {
  cnpj_basico                String                   @id @db.Char(8)
  razao_social               String
  natureza_juridica          String                   @db.Char(4)
  qualificacao_responsavel   String                   @db.Char(2)
  capital_social             Decimal?                 @db.Decimal(18, 2)
  porte                      String?                  @db.Char(1)
  ente_federativo            String?                  @db.VarChar(50)

  natureza_juridica_rel      naturezas_juridicas      @relation("empresa_natureza", fields: [natureza_juridica], references: [codigo])
  qualificacao_responsavel_rel qualificacoes_socios   @relation("empresa_qualificacao_resp", fields: [qualificacao_responsavel], references: [codigo])

  estabelecimentos           estabelecimentos[]
  socios                     socios[]
  dados_simples              dados_simples?

  @@index([razao_social, porte, natureza_juridica])
}

model estabelecimentos {
  cnpj_basico                String                   @db.Char(8)
  cnpj_ordem                 String                   @db.Char(4)
  cnpj_dv                    String                   @db.Char(2)
  identificador_matriz_filial Int
  nome_fantasia              String?
  situacao_cadastral         Int
  data_situacao_cadastral    DateTime?                @db.Date
  motivo_situacao_cadastral  String                   @db.Char(2)
  nome_cidade_exterior       String?
  pais                       String?                  @db.Char(3)
  data_inicio_atividade      DateTime?                @db.Date
  cnae_fiscal_principal      String                   @db.Char(7)
  cnae_fiscal_secundaria     String?
  tipo_logradouro            String?                  @db.VarChar(20)
  logradouro                 String?
  numero                     String?                  @db.VarChar(20)
  complemento                String?
  bairro                     String?
  cep                        String?                  @db.Char(8)
  uf                         String?                  @db.Char(2)
  municipio                  String?                  @db.Char(7)
  ddd1                       String?                  @db.Char(4)
  telefone1                  String?
  ddd2                       String?                  @db.Char(4)
  telefone2                  String?
  ddd_fax                    String?                  @db.Char(4)
  fax                        String?
  correio_eletronico         String?
  situacao_especial          String?
  data_situacao_especial     DateTime?                @db.Date

  empresa                    empresas                 @relation(fields: [cnpj_basico], references: [cnpj_basico])
  cnae_principal_rel         cnaes                    @relation("estab_cnae_principal", fields: [cnae_fiscal_principal], references: [codigo])
  motivo_situacao_rel        motivos                  @relation("estab_motivo_situacao", fields: [motivo_situacao_cadastral], references: [codigo])
  municipio_rel              municipios?              @relation("estab_municipio", fields: [municipio], references: [codigo])
  pais_rel                   paises?                  @relation("estab_pais", fields: [pais], references: [codigo])

  @@id([cnpj_basico, cnpj_ordem, cnpj_dv])
  @@index([cnpj_basico, uf, situacao_cadastral, cnae_fiscal_principal, nome_fantasia, municipio, cep])
}

model socios {
  id                            BigInt                 @id @default(autoincrement())
  cnpj_basico                   String                 @db.Char(8)
  identificador_de_socio        Int
  nome_socio                    String?
  cnpj_cpf_do_socio             String?
  qualificacao_do_socio         String?                  @db.Char(2)
  data_entrada_sociedade        DateTime?                @db.Date
  pais                          String?                  @db.Char(3)
  representante_legal           String?                  @db.Char(11)
  nome_do_representante         String?
  qualificacao_representante_legal String?               @db.Char(2)
  faixa_etaria                  String?                  @db.Char(1)

  empresa                       empresas               @relation(fields: [cnpj_basico], references: [cnpj_basico])
  qualificacao_socio_rel        qualificacoes_socios?  @relation("socio_qualificacao", fields: [qualificacao_do_socio], references: [codigo])
  pais_rel                      paises?                @relation("socio_pais", fields: [pais], references: [codigo])
  qualificacao_representante_rel qualificacoes_socios? @relation("socio_qualif_representante", fields: [qualificacao_representante_legal], references: [codigo])

  @@index([cnpj_basico, nome_socio, cnpj_cpf_do_socio])
}

model dados_simples {
  cnpj_basico           String                   @id @db.Char(8)
  opcao_pelo_simples    String?                  @db.Char(1)
  data_opcao_simples    DateTime?                @db.Date
  data_exclusao_simples DateTime?                @db.Date
  opcao_pelo_mei        String?                  @db.Char(1)
  data_opcao_mei        DateTime?                @db.Date
  data_exclusao_mei     DateTime?                @db.Date

  empresa               empresas                 @relation(fields: [cnpj_basico], references: [cnpj_basico])

  @@index([opcao_pelo_simples, opcao_pelo_mei])
}

model cnaes {
  codigo      String               @id @db.Char(7)
  descricao   String

  estabelecimentos_cnae estabelecimentos[] @relation("estab_cnae_principal")
}

model motivos {
  codigo      String               @id @db.Char(2)
  descricao   String

  estabelecimentos_motivo estabelecimentos[] @relation("estab_motivo_situacao")
}

model municipios {
  codigo      String               @id @db.Char(7)
  descricao   String
  uf          String?              @db.Char(2)

  estabelecimentos_municipio estabelecimentos[] @relation("estab_municipio")
}

model naturezas_juridicas {
  codigo      String               @id @db.Char(4)
  descricao   String

  empresas_natureza empresas[] @relation("empresa_natureza")
}

model paises {
  codigo      String               @id @db.Char(3)
  descricao   String

  estabelecimentos_pais estabelecimentos[] @relation("estab_pais")
  socios_pais           socios[]           @relation("socio_pais")
}

model qualificacoes_socios {
  codigo      String               @id @db.Char(2)
  descricao   String

  empresas_qualificacao_resp         empresas[] @relation("empresa_qualificacao_resp")
  socios_qualificacao                socios[]   @relation("socio_qualificacao")
  socios_qualificacao_representante  socios[]   @relation("socio_qualif_representante")
}
